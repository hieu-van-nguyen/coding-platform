rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Problem catalog: anyone can read (the list is visible before sign-in).
    // Writes come only from the Firebase console or Admin SDK scripts,
    // which bypass these rules.
    match /problems/{problemId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-user data: each signed-in user can read and write only their own
    // documents, including progress/ (solved status) and submissions/ (code).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
